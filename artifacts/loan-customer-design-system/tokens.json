{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f9f7f0", "$description": "Warm paper page surface from the source app." },
      "foreground": { "$value": "#1d3a34" },
      "border": { "$value": "#e2dbcf" },
      "card": { "$value": "#fbf9f3" },
      "cardForeground": { "$value": "#1d3a34" },
      "popover": { "$value": "#fcfbf8" },
      "popoverForeground": { "$value": "#1d3a34" },
      "primary": { "$value": "#1d4039", "$description": "Evergreen ink used for primary actions and brand emphasis." },
      "primaryForeground": { "$value": "#f5f1e7" },
      "secondary": { "$value": "#e9eee5", "$description": "Soft sage surfaces used to separate sections." },
      "secondaryForeground": { "$value": "#22443d" },
      "muted": { "$value": "#eeeae2" },
      "mutedForeground": { "$value": "#526a61" },
      "accent": { "$value": "#d7774b", "$description": "Warm rust accent used sparingly for emphasis." },
      "accentForeground": { "$value": "#2f1c16" },
      "destructive": { "$value": "#c43631" },
      "destructiveForeground": { "$value": "#162724" },
      "input": { "$value": "#d8d8ce" },
      "ring": { "$value": "#356656" },
      "chart1": { "$value": "#1d4039" },
      "chart2": { "$value": "#5f8c73" },
      "chart3": { "$value": "#d7774b" },
      "chart4": { "$value": "#b89a6c" },
      "chart5": { "$value": "#718b7d" },
      "sidebar": { "$value": "#fbf9f3" },
      "sidebarForeground": { "$value": "#294a41" },
      "sidebarBorder": { "$value": "#e2dbcf" },
      "sidebarPrimary": { "$value": "#1d4039" },
      "sidebarPrimaryForeground": { "$value": "#f5f1e7" },
      "sidebarAccent": { "$value": "#e9eee5" },
      "sidebarAccentForeground": { "$value": "#22443d" },
      "sidebarRing": { "$value": "#356656" }
    },
    "dark": {
      "background": { "$value": "#162724" },
      "foreground": { "$value": "#f1ede4" },
      "border": { "$value": "#3b544e" },
      "card": { "$value": "#1f332f" },
      "cardForeground": { "$value": "#f1ede4" },
      "popover": { "$value": "#1f332f" },
      "popoverForeground": { "$value": "#f1ede4" },
      "primary": { "$value": "#dfc290" },
      "primaryForeground": { "$value": "#182f2a" },
      "secondary": { "$value": "#2f4641" },
      "secondaryForeground": { "$value": "#f1ede4" },
      "muted": { "$value": "#2e423e" },
      "mutedForeground": { "$value": "#b9b2a2" },
      "accent": { "$value": "#de8a59" },
      "accentForeground": { "$value": "#2b1c14" },
      "destructive": { "$value": "#e07c74" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#3b544e" },
      "ring": { "$value": "#dfc290" },
      "chart1": { "$value": "#dfc290" },
      "chart2": { "$value": "#8fb39c" },
      "chart3": { "$value": "#de8a59" },
      "chart4": { "$value": "#d8c7a6" },
      "chart5": { "$value": "#779b8b" },
      "sidebar": { "$value": "#13211e" },
      "sidebarForeground": { "$value": "#f1ede4" },
      "sidebarBorder": { "$value": "#344a45" },
      "sidebarPrimary": { "$value": "#dfc290" },
      "sidebarPrimaryForeground": { "$value": "#182f2a" },
      "sidebarAccent": { "$value": "#2f4641" },
      "sidebarAccentForeground": { "$value": "#f1ede4" },
      "sidebarRing": { "$value": "#dfc290" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "The source app's UI and body typeface."
      },
      "serif": {
        "$value": ["Newsreader", "Georgia", "serif"],
        "$description": "The source app's editorial heading typeface."
      },
      "mono": { "$value": ["ui-monospace", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.8rem",
      "$description": "Source theme radius; component surfaces use 10px controls and 20px cards."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
